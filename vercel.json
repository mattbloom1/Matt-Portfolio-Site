{
  "redirects": [
    {
      "source": "/:sec(work|projects|websites|crafts)/the-gvc-team(/)?",
      "destination": "/work/gvc-team/",
      "permanent": true
    },
    {
      "source": "/:sec(work|projects|websites|crafts)/trimble-business-systems(/)?",
      "destination": "/work/trimble/",
      "permanent": true
    },
    {
      "source": "/:sec(work|projects|websites|crafts)/pictorial-symbols-library(/)?",
      "destination": "/work/pictorial-symbols/",
      "permanent": true
    },
    {
      "source": "/:sec(work|projects|websites|crafts)/client-portfolio-site(/)?",
      "destination": "/work/client-portfolio/",
      "permanent": true
    },
    {
      "source": "/:sec(projects|websites|crafts)(/)?",
      "destination": "/work/",
      "permanent": true
    },
    {
      "source": "/:sec(projects|websites|crafts)/:rest((?!.*\\.).*)(/)?",
      "destination": "/work/:rest",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(stamps|photography|projects|crafts|websites|posters|about|ignite|logo|resume)/(.*)\\.(webp|jpg|jpeg|png|gif|svg|mp4|json|woff2|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
